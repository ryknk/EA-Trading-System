{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/v1/trade-decision-response.schema.json",
  "title": "TradeDecisionResponseV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "decision", "reason_code", "ml", "llm", "created_at", "expires_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "request_id": {"type": "string", "format": "uuid"},
    "decision": {"enum": ["ALLOW", "VETO"]},
    "reason_code": {"type": "string", "pattern": "^[A-Z0-9_]{1,64}$"},
    "ml": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "model_version"],
      "properties": {
        "status": {"enum": ["PASSED", "REJECTED", "ERROR"]},
        "win_probability": {"type": "number", "minimum": 0, "maximum": 1},
        "expected_return": {"type": "number"},
        "model_version": {"type": "string", "maxLength": 64}
      }
    },
    "llm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["NOT_CALLED", "ALLOW", "VETO", "ERROR"]},
        "provider": {"type": "string", "maxLength": 32},
        "model": {"type": "string", "maxLength": 64},
        "prompt_version": {"type": "string", "maxLength": 32},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "reason": {"type": "string", "maxLength": 512}
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"}
  }
}
