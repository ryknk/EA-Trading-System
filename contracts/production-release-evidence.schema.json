{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/v1/production-release-evidence.schema.json",
  "title": "ProductionReleaseEvidenceV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "environment", "aws_account_id", "aws_region",
    "ml_model_version", "ml_model_sha256", "llm_provider", "llm_model", "prompt_version",
    "oos_report", "walk_forward_report", "demo_report", "small_real_report",
    "vps_secret_file_verified", "sns_notification_verified", "budgets_verified",
    "rollback_drill_verified", "approved_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "environment": {"const": "production"},
    "aws_account_id": {"type": "string", "pattern": "^[0-9]{12}$"},
    "aws_region": {"type": "string", "pattern": "^[a-z]{2}-[a-z]+-[0-9]$"},
    "ml_model_version": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$"},
    "ml_model_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "llm_provider": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,32}$"},
    "llm_model": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$"},
    "prompt_version": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,32}$"},
    "oos_report": {"type": "string", "minLength": 1},
    "walk_forward_report": {"type": "string", "minLength": 1},
    "demo_report": {"type": "string", "minLength": 1},
    "small_real_report": {"type": "string", "minLength": 1},
    "vps_secret_file_verified": {"const": true},
    "sns_notification_verified": {"const": true},
    "budgets_verified": {"const": true},
    "rollback_drill_verified": {"const": true},
    "approved_at": {"type": "string", "format": "date-time"}
  }
}
